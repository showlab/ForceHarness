# Copy to .env (never commit it). Scripts load it automatically.
#
# OpenAI (Responses API; GPT-6 Astra / GPT-6.1 Sol in the paper). The configs refer to this variable as api_key_env: FH_API_KEY.
FH_API_KEY=
# Optional: an OpenAI-compatible endpoint instead of api.openai.com (e.g. a Gemini OpenAI-compatible endpoint).
# FH_API_BASE=
# Anthropic (Claude Fable 5.2 in the paper): run with --provider anthropic --api-key-env ANTHROPIC_API_KEY
ANTHROPIC_API_KEY=
